{
  "name": "hansard-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server giving AI assistants sourced, live UK Parliament data: Hansard, votes, bills, committees and members, with every answer cited.",
  "author": "Josh Feldberg",
  "license": "MIT",
  "homepage": "https://hansard-mcp.feldberg.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PepoBCN/hansard-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/PepoBCN/hansard-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:http": "tsx watch src/http.ts",
    "start:http": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "evals": "node scripts/run-evals.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "undici": "^8.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
